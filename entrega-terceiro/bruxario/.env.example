# ─────────────────────────────────────────────────────────────────────────
#  Copie para `.env` e preencha. NADA aqui tem valor de verdade.
# ─────────────────────────────────────────────────────────────────────────

# O endereço público do site. Entra nos links dos e-mails e no card social.
BASE_URL=https://SEU-DOMINIO.com.br

# ── Identidade da loja ───────────────────────────────────────────────────
# Aparecem na arte impressa, no rodapé e nos e-mails.
NEXT_PUBLIC_MARCA_NOME=
NEXT_PUBLIC_MARCA_DOMINIO=
# Sem o "@". Vazio esconde os links de rede social em vez de mostrá-los quebrados.
NEXT_PUBLIC_MARCA_ARROBA=

# ── Páginas legais (LGPD art. 41 exige controlador identificável) ────────
LEGAL_CONTROLADOR=
LEGAL_SITE=
LEGAL_HOSPEDAGEM=

# ── Painel administrativo ────────────────────────────────────────────────
# O ÚNICO endereço que recebe o link de acesso ao painel. Não há cadastro:
# quem não recebe e-mail nesta caixa não entra.
ADMIN_EMAIL=

# ── DirectPag ────────────────────────────────────────────────────────────
# Token da API. Vai em query string em toda requisição — ver docs/DIRECTPAG.md.
DIRECTPAG_API_TOKEN=
# Criados uma vez na conta. `npm run tsx scripts/directpag-setup.ts` cria e imprime.
DIRECTPAG_PRODUCT_HASH=
DIRECTPAG_OFFER_HASH=

# ── IA que escreve a leitura ─────────────────────────────────────────────
GEMINI_API_KEY=
# Alternativa; ver src/nucleo/modelos.ts para trocar o provedor.
OPENAI_API_KEY=

# ── E-mail (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_REMETENTE="Nome <contato@seu-dominio.com.br>"

# ── Pixel da Meta ────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
# Opcional. Sem ele os eventos ficam na fila e não são enviados — o disparo
# do navegador continua funcionando sozinho.
META_CAPI_ACCESS_TOKEN=

# ── Licença ──────────────────────────────────────────────────────────────
# Preenchidos por quem licencia. Ausentes, a aplicação roda normalmente.
LICENCA_URL=
LICENCA_CHAVE_PUBLICA=

# ── Onde o banco e os arquivos vivem ─────────────────────────────────────
# Padrão: ./var/data. Aponte para um volume persistente em produção.
BRUXARIO_DIR_DADOS=

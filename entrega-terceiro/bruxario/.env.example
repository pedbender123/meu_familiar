# Copie para `.env` e preencha.

# O endereço público do site. Entra nos links dos e-mails e no card social.
BASE_URL=https://SEU-DOMINIO.com.br

# ── Identidade ───────────────────────────────────────────────────────────
# Aparecem na arte impressa, no rodapé e nos e-mails.
NEXT_PUBLIC_MARCA_NOME=
NEXT_PUBLIC_MARCA_DOMINIO=
# Sem o "@". Vazio esconde os links de rede social em vez de mostrá-los quebrados.
NEXT_PUBLIC_MARCA_ARROBA=

# ── Páginas legais (a LGPD exige controlador identificável) ──────────────
LEGAL_CONTROLADOR=
LEGAL_SITE=
LEGAL_HOSPEDAGEM=

# ── Painel ───────────────────────────────────────────────────────────────
# O ÚNICO endereço que recebe o link de acesso. Não há cadastro: quem não
# recebe e-mail nesta caixa não entra.
ADMIN_EMAIL=

# ── DirectPag ────────────────────────────────────────────────────────────
# Ver docs/DIRECTPAG.md.
DIRECTPAG_API_TOKEN=
DIRECTPAG_PRODUCT_HASH=
DIRECTPAG_OFFER_HASH=

# ── Utmify ───────────────────────────────────────────────────────────────
# Ver docs/UTMIFY.md.
NEXT_PUBLIC_UTMIFY_PIXEL_ID=
UTMIFY_API_TOKEN=
# Nome que aparece como origem no painel da Utmify.
UTMIFY_PLATAFORMA=DirectPag
# `1` manda os pedidos como teste, sem sujar o relatório.
UTMIFY_TESTE=

# ── IA que escreve a leitura ─────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── E-mail (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_REMETENTE="Nome <contato@seu-dominio.com.br>"

# ── Pixel da Meta ────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=

# ── Onde o banco e os arquivos vivem ─────────────────────────────────────
# Padrão: ./var/data. Aponte para um volume persistente em produção.
BRUXARIO_DIR_DADOS=

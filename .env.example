# --- Mercado Pago (SPEC 10.1, decisão definitiva) ---
# Access token privado, do painel Suas Integrações. NUNCA vai pro navegador.
# ⚠️ VAZIO EM PRODUÇÃO = provedor fake que aprova tudo de graça.
MP_ACCESS_TOKEN=
# Chave pública do Payment Brick. Vai pro navegador de propósito.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# "Assinatura secreta" da aplicação, usada para validar o webhook.
MP_WEBHOOK_SECRET=

# --- E-mail (Resend) ---
# Sem chave, o app não quebra: imprime o e-mail no console em vez de enviar.
# É assim que dá pra desenvolver link mágico e entrega antes do DNS resolver.
RESEND_API_KEY=
# Precisa ser de um domínio VERIFICADO no Resend, senão o envio é recusado.
EMAIL_REMETENTE="Bruxário <familiar@bruxario.com.br>"

# --- IA ---
GEMINI_API_KEY=

# --- Geral ---
# Usado nos links que vão por e-mail. Em produção: https://bruxario.com.br
BASE_URL=http://localhost:3000

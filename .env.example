# ═══════════════════════════════════════════════════════════════════════════
#  MODO DE PAGAMENTO
#  teste    → credenciais TEST-, cartões de teste, NADA é cobrado
#  producao → credenciais APP_USR-, COBRA DE VERDADE
#
#  Trocar aqui e reiniciar basta: não precisa rebuildar. A tela de pagamento
#  mostra uma faixa amarela quando não está em produção.
# ═══════════════════════════════════════════════════════════════════════════
MP_MODO=teste

# ─── Mercado Pago · TESTE ────────────────────────────────────────────────
# Painel → Suas Integrações → sua aplicação → Credenciais de TESTE
MP_TESTE_ACCESS_TOKEN=
MP_TESTE_PUBLIC_KEY=
# Opcional: só se você cadastrar um webhook separado pro ambiente de teste.
# Vazio = usa MP_WEBHOOK_SECRET abaixo.
MP_TESTE_WEBHOOK_SECRET=

# ─── Mercado Pago · PRODUÇÃO ─────────────────────────────────────────────
# ⚠️ Estas cobram de verdade. Só entram em ação com MP_MODO=producao.
MP_PROD_ACCESS_TOKEN=
MP_PROD_PUBLIC_KEY=
MP_PROD_WEBHOOK_SECRET=

# Segredo do webhook da aplicação, usado quando não há um específico por modo.
MP_WEBHOOK_SECRET=

# ─── E-mail (Resend) ─────────────────────────────────────────────────────
# Vazio = o app imprime o e-mail no console em vez de enviar.
RESEND_API_KEY=
EMAIL_REMETENTE="Bruxário <familiar@bruxario.com.br>"

# ─── Painel ──────────────────────────────────────────────────────────────
# O ÚNICO endereço que recebe link de acesso ao painel. Não há cadastro, não
# há senha: quem não recebe e-mail aqui não entra. Vazio = painel desligado.
ADMIN_EMAIL=

# ─── IA ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Geral ───────────────────────────────────────────────────────────────
# Em produção: https://bruxario.com.br
# Localmente, se for testar webhook, use o túnel (o MP precisa te alcançar).
BASE_URL=http://localhost:3000

# Ponte com o AetherOS (Petrus). Ver AETHER_LINK.md.
AETHER_LINK_TOKEN=
AETHER_URL=ws://127.0.0.1:8000/ws/projects

# Plano B da leitura de palma (navegador sem WebGL). Vazio desliga o plano B.
NEXT_PUBLIC_PALMA_API=

# ─── Pixel da Meta ───────────────────────────────────────────────────────
# Só alimenta o Ads Manager (Lead, InitiateCheckout, Purchase) — não decide
# nada no site, isso já é feito pelo nosso rastreio interno. Vazio = pixel
# desligado, nenhum script sobe.
NEXT_PUBLIC_META_PIXEL_ID=

# ═══════════════════════════════════════════════════════════════════════════
#  HORÓSCOPO — produto separado (ver src/lib/horoscopo/, src/app/horoscopo/)
#  Não alimenta a plataforma principal: banco, Mercado Pago e pixel próprios,
#  de propósito. Nada aqui pode ser confundido com as variáveis MP_* /
#  NEXT_PUBLIC_META_PIXEL_ID de cima, que são só do Bruxário.
# ═══════════════════════════════════════════════════════════════════════════
MP_HOROSCOPO_MODO=teste
MP_HOROSCOPO_TESTE_ACCESS_TOKEN=
MP_HOROSCOPO_TESTE_PUBLIC_KEY=
MP_HOROSCOPO_TESTE_WEBHOOK_SECRET=
MP_HOROSCOPO_PROD_ACCESS_TOKEN=
MP_HOROSCOPO_PROD_PUBLIC_KEY=
MP_HOROSCOPO_PROD_WEBHOOK_SECRET=

# Vazio = pixel do Horóscopo desligado (o pixel do Bruxário também não
# dispara em /horoscopo — ver o guard em components/MetaPixel.tsx).
NEXT_PUBLIC_META_PIXEL_ID_HOROSCOPO=
